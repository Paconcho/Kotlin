package Clases;

public class Alumno {
	String nombre;
	int nota;
	
	public Alumno(String nombre, int nota) {
		super();
		this.nombre = nombre;
		this.nota = nota;
	}
	
	public Alumno() {
		super();
	}

	public String getNombre() {
		return nombre;
	}
	
	public void setNombre(String nombre) {
		this.nombre = nombre;
	}
	
	public int getNota() {
		return nota;
	}
	
	public void setNota(int nota) {
		this.nota = nota;
	}

}
