	public ArrayList<Usuario> getAll() {

		Connection con = ConexionBD.conectar();
		String sql;
		ArrayList<Usuario> lista = new ArrayList();
		Usuario u;

		try {
			sql = """
					SELECT id, email, nombre, password,   fechaNacimiento
					FROM usuario
					ORDER BY nombre
					""";

			PreparedStatement st = con.prepareStatement(sql);
			ResultSet rs = st.executeQuery();
			while (rs.next()) {
				u = new Usuario();
				u.setId(rs.getInt("id"));
				u.setEmail(rs.getString("email"));
				u.setNombre(rs.getString("nombre"));
				u.setPassword(rs.getString("password"));
				Date fechaNacimiento = rs.getDate("fecha nacimiento");
				if (fechaNacimiento != null) {
					u.setFechaNacimiento(fechaNacimiento.toLocalDate());
				}

				lista.add(u);
			}
			ConexionBD.desconectar(con);
		} catch (SQLException e) {
			System.out.println("Error en GetAll: " + e.getMessage());
		}
		return lista;
	}

	public void save(Usuario user) {

		Connection con = ConexionBD.conectar();
		String sql;

		try {
			sql = """
					INSERT INTO usuario(id, email, nombre, password, fechaNacimiento)
					VALUES(?, ?, ?, ?, ?)
					""";
			PreparedStatement st = con.prepareStatement(sql);
			st.setInt(1, user.getId());
			st.setString(2, user.getEmail());
			st.setString(3, user.getNombre());
			st.setString(4, user.getPassword());

			// st.setDate(3, Date.valueOf(arbol.getFechaPlantacion()));
			if (user.getFechaNacimiento() != null) {
				st.setDate(5, Date.valueOf(user.getFechaNacimiento()));
			} else {
				st.setNull(5, Types.DATE);
			}

			st.executeUpdate();
			ConexionBD.desconectar(con);
		} catch (SQLException e) {
			System.out.println("Error en saveTree: " + e.getMessage());

		}

	}

